{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Social Media Campaign Plan",
  "type": "object",
  "required": ["campaign_goal", "platforms", "content_pillars", "calendar", "kpis"],
  "properties": {
    "campaign_goal": {"type": "string"},
    "duration_weeks": {"type": "integer"},
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "rationale", "posting_frequency", "content_mix"],
        "properties": {
          "platform": {"type": "string", "enum": ["LinkedIn", "Instagram", "X", "TikTok", "Facebook", "YouTube"]},
          "rationale": {"type": "string"},
          "posting_frequency": {"type": "string"},
          "content_mix": {
            "type": "object",
            "properties": {
              "video_pct": {"type": "number"},
              "carousel_pct": {"type": "number"},
              "static_pct": {"type": "number"},
              "text_pct": {"type": "number"}
            }
          }
        }
      }
    },
    "content_pillars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "description", "post_ideas", "formats"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "post_ideas": {"type": "array", "items": {"type": "string"}, "minItems": 3},
          "formats": {"type": "array", "items": {"type": "string"}},
          "engagement_mechanic": {"type": "string"}
        }
      }
    },
    "calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["week", "theme", "posts"],
        "properties": {
          "week": {"type": "integer"},
          "theme": {"type": "string"},
          "posts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["day", "platform", "type", "hook", "goal"],
              "properties": {
                "day": {"type": "string"},
                "platform": {"type": "string"},
                "type": {"type": "string"},
                "hook": {"type": "string"},
                "goal": {"type": "string"},
                "production_hours": {"type": "number"}
              }
            }
          },
          "hero_content": {"type": "string"}
        }
      }
    },
    "hooks_library": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 10
    },
    "hashtag_strategy": {
      "type": "object",
      "properties": {
        "niche": {"type": "array", "items": {"type": "string"}},
        "mid_tier": {"type": "array", "items": {"type": "string"}},
        "broad": {"type": "array", "items": {"type": "string"}},
        "brand": {"type": "string"}
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "platform", "target"],
        "properties": {
          "metric": {"type": "string"},
          "platform": {"type": "string"},
          "target": {"type": "string"},
          "measurement_method": {"type": "string"}
        }
      }
    }
  }
}
