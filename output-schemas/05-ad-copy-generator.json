{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ad Creative Package",
  "type": "object",
  "required": ["product", "campaign_goal", "audience_temperature"],
  "properties": {
    "product": {"type": "string"},
    "campaign_goal": {"type": "string"},
    "audience_temperature": {"type": "string", "enum": ["cold", "warm", "hot"]},
    "google_search": {
      "type": "object",
      "properties": {
        "rsa_headlines": {
          "type": "array",
          "minItems": 10,
          "maxItems": 15,
          "items": {
            "type": "object",
            "required": ["text", "chars"],
            "properties": {
              "text": {"type": "string", "maxLength": 30},
              "chars": {"type": "integer", "maximum": 30},
              "pin_recommendation": {"type": "string"},
              "type": {"type": "string"}
            }
          }
        },
        "rsa_descriptions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["text", "angle"],
            "properties": {
              "text": {"type": "string", "maxLength": 90},
              "angle": {"type": "string"}
            }
          }
        },
        "sitelinks": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "title": {"type": "string", "maxLength": 25},
              "line1": {"type": "string", "maxLength": 35},
              "line2": {"type": "string", "maxLength": 35}
            }
          }
        },
        "callouts": {"type": "array", "items": {"type": "string", "maxLength": 25}}
      }
    },
    "meta_ads": {
      "type": "object",
      "properties": {
        "feed_ad": {
          "type": "object",
          "properties": {
            "primary_text": {"type": "string", "maxLength": 2000},
            "headline": {"type": "string", "maxLength": 40},
            "description": {"type": "string", "maxLength": 30},
            "cta_button": {"type": "string"},
            "visual_brief": {"type": "string"},
            "hook_type": {"type": "string"}
          }
        },
        "carousel_ad": {
          "type": "object",
          "properties": {
            "cards": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "card_number": {"type": "integer"},
                  "theme": {"type": "string"},
                  "headline": {"type": "string", "maxLength": 40},
                  "description": {"type": "string", "maxLength": 20}
                }
              }
            }
          }
        }
      }
    },
    "ab_test_matrix": {
      "type": "object",
      "properties": {
        "variable": {"type": "string"},
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {"type": "string"},
              "hook_type": {"type": "string"},
              "hook": {"type": "string"}
            }
          }
        },
        "recommendation": {"type": "string"}
      }
    },
    "compliance_flags": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
