{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Voice Architect Output",
  "description": "Structured output schema for brand voice definition and guidelines",
  "type": "object",
  "required": ["brand_foundation", "voice_attributes", "tone_modulation"],
  "properties": {
    "brand_foundation": {
      "type": "object",
      "required": ["brand_essence", "target_audience"],
      "properties": {
        "brand_essence": { "type": "string" },
        "target_audience": { "type": "object", "properties": { "description": { "type": "string" }, "language_preferences": { "type": "string" }, "communication_expectations": { "type": "string" } } },
        "competitive_landscape": { "type": "string" },
        "voice_positioning": { "type": "string" }
      }
    },
    "voice_attributes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "definition", "spectrum", "do_examples", "dont_examples"],
        "properties": {
          "name": { "type": "string" },
          "definition": { "type": "string" },
          "spectrum": { "type": "string", "description": "This, not that" },
          "do_examples": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
          "dont_examples": { "type": "array", "items": { "type": "string" }, "minItems": 3 }
        }
      }
    },
    "tone_modulation": {
      "type": "object",
      "required": ["tone_matrix"],
      "properties": {
        "tone_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "energy", "formality"],
            "properties": {
              "context": { "type": "string" },
              "energy": { "type": "string", "enum": ["Low", "Medium", "High"] },
              "formality": { "type": "string", "enum": ["Very Low", "Low", "Medium", "High", "Very High"] },
              "humor": { "type": "string", "enum": ["None", "Light", "Low", "Medium", "High"] },
              "empathy": { "type": "string", "enum": ["Low", "Medium", "High"] },
              "example": { "type": "string" }
            }
          }
        },
        "context_examples": { "type": "array", "items": { "type": "object", "properties": { "context": { "type": "string" }, "same_message_rewritten": { "type": "string" } } } }
      }
    },
    "vocabulary_guide": {
      "type": "object",
      "properties": {
        "preferred_terms": { "type": "array", "items": { "type": "string" } },
        "avoid_terms": { "type": "array", "items": { "type": "string" } },
        "banned_terms": { "type": "array", "items": { "type": "string" } },
        "power_words": { "type": "array", "items": { "type": "string" } }
      }
    },
    "formatting_guidelines": {
      "type": "object",
      "properties": {
        "sentence_structure": { "type": "string" },
        "punctuation": { "type": "string" },
        "emoji_usage": { "type": "string" },
        "capitalization": { "type": "string" }
      }
    },
    "ai_prompt_guide": {
      "type": "object",
      "properties": {
        "system_prompt_template": { "type": "string" },
        "content_type_prompts": { "type": "array", "items": { "type": "object", "properties": { "content_type": { "type": "string" }, "prompt": { "type": "string" } } } }
      }
    },
    "voice_check_rubric": {
      "type": "array",
      "items": { "type": "object", "properties": { "criterion": { "type": "string" }, "on_brand": { "type": "string" }, "needs_work": { "type": "string" }, "off_brand": { "type": "string" } } }
    }
  }
}
