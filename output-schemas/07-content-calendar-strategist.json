{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Content Calendar Plan",
  "type": "object",
  "required": ["business_goal", "content_pillars", "monthly_calendar", "repurposing_system", "kpis"],
  "properties": {
    "business_goal": {"type": "string"},
    "timeline_weeks": {"type": "integer"},
    "team_capacity_hours_per_week": {"type": "number"},
    "content_pillars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "why", "audience_stage", "content_types"],
        "properties": {
          "name": {"type": "string"},
          "why": {"type": "string"},
          "audience_stage": {"type": "string", "enum": ["TOFU", "MOFU", "BOFU", "TOFU/MOFU", "MOFU/BOFU", "all"]},
          "primary_channel": {"type": "string"},
          "content_types": {"type": "array", "items": {"type": "string"}},
          "monthly_output": {"type": "string"}
        }
      }
    },
    "monthly_calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["week", "theme", "content_items"],
        "properties": {
          "week": {"type": "integer"},
          "theme": {"type": "string"},
          "content_items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["day", "channel", "type", "title", "goal", "production_hours"],
              "properties": {
                "day": {"type": "string"},
                "channel": {"type": "string"},
                "type": {"type": "string"},
                "title": {"type": "string"},
                "goal": {"type": "string"},
                "production_hours": {"type": "number"},
                "repurposed_from": {"type": "string"},
                "status": {"type": "string", "enum": ["draft", "in_review", "scheduled", "published", "open"]}
              }
            }
          }
        }
      }
    },
    "repurposing_system": {
      "type": "object",
      "properties": {
        "source_content": {"type": "string"},
        "source_hours": {"type": "number"},
        "derivatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "content_type": {"type": "string"},
              "channel": {"type": "string"},
              "hours": {"type": "number"}
            }
          }
        },
        "total_additional_hours": {"type": "number"},
        "multiplier": {"type": "string"}
      }
    },
    "editorial_brief_template": {"type": "string"},
    "kpis": {
      "type": "object",
      "properties": {
        "weekly": {"type": "array", "items": {"type": "object", "properties": {"metric": {"type": "string"}, "target": {"type": "string"}}}},
        "monthly": {"type": "array", "items": {"type": "object", "properties": {"metric": {"type": "string"}, "target": {"type": "string"}}}},
        "quarterly": {"type": "array", "items": {"type": "object", "properties": {"metric": {"type": "string"}, "target": {"type": "string"}}}}
      }
    }
  }
}
