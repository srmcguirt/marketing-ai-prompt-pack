{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Social Media Campaign Planner Output",
  "description": "Structured output schema for social media campaign planning",
  "type": "object",
  "required": ["campaign_overview", "platform_strategies", "measurement"],
  "properties": {
    "campaign_overview": {
      "type": "object",
      "required": ["objective", "target_audience", "timeline", "budget"],
      "properties": {
        "objective": { "type": "string" },
        "target_audience": { "type": "object", "properties": { "demographics": { "type": "string" }, "psychographics": { "type": "string" }, "platforms": { "type": "array", "items": { "type": "string" } } } },
        "timeline": { "type": "string" },
        "budget": { "type": "object", "properties": { "total": { "type": "string" }, "allocation": { "type": "array", "items": { "type": "object", "properties": { "category": { "type": "string" }, "amount": { "type": "string" }, "percentage": { "type": "number" } } } } } }
      }
    },
    "platform_strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "content_formats", "posting_cadence", "content_pillars"],
        "properties": {
          "platform": { "type": "string" },
          "content_formats": { "type": "array", "items": { "type": "string" } },
          "posting_cadence": { "type": "string" },
          "optimal_times": { "type": "string" },
          "content_pillars": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "frequency": { "type": "string" } } } },
          "hashtag_strategy": { "type": "object", "properties": { "branded": { "type": "array", "items": { "type": "string" } }, "community": { "type": "array", "items": { "type": "string" } } } },
          "sample_posts": { "type": "array", "items": { "type": "object", "properties": { "type": { "type": "string" }, "concept": { "type": "string" }, "copy": { "type": "string" } } } }
        }
      }
    },
    "content_calendar": { "type": "array", "items": { "type": "object", "properties": { "week": { "type": "integer" }, "theme": { "type": "string" }, "posts": { "type": "array", "items": { "type": "object", "properties": { "day": { "type": "string" }, "platform": { "type": "string" }, "content_type": { "type": "string" }, "topic": { "type": "string" } } } } } } },
    "content_repurposing": { "type": "array", "items": { "type": "object", "properties": { "anchor_content": { "type": "string" }, "derivatives": { "type": "array", "items": { "type": "string" } } } } },
    "measurement": {
      "type": "object",
      "required": ["kpis"],
      "properties": {
        "kpis": { "type": "array", "items": { "type": "object", "required": ["metric", "target"], "properties": { "metric": { "type": "string" }, "target": { "type": "string" }, "measurement_tool": { "type": "string" }, "review_cadence": { "type": "string" } } } },
        "reporting_template": { "type": "string" }
      }
    },
    "community_management": { "type": "object", "properties": { "response_playbook": { "type": "array", "items": { "type": "object", "properties": { "scenario": { "type": "string" }, "response_approach": { "type": "string" }, "example": { "type": "string" } } } } } }
  }
}
