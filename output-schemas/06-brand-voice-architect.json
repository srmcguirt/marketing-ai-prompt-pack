{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand Voice Guide",
  "type": "object",
  "required": ["brand_name", "voice_dimensions", "voice_spectrum", "writing_mechanics", "banned_words", "quick_reference"],
  "properties": {
    "brand_name": {"type": "string"},
    "voice_dimensions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "one_sentence", "we_do", "we_dont", "on_brand_example", "off_brand_example"],
        "properties": {
          "name": {"type": "string"},
          "one_sentence": {"type": "string"},
          "we_do": {"type": "array", "items": {"type": "string"}, "minItems": 3},
          "we_dont": {"type": "array", "items": {"type": "string"}, "minItems": 2},
          "on_brand_example": {"type": "string"},
          "off_brand_example": {"type": "string"}
        }
      }
    },
    "voice_spectrum": {
      "type": "object",
      "properties": {
        "formal_to_conversational": {
          "type": "object",
          "properties": {"score": {"type": "integer", "minimum": 1, "maximum": 10}, "description": {"type": "string"}}
        },
        "reserved_to_expressive": {
          "type": "object",
          "properties": {"score": {"type": "integer"}, "description": {"type": "string"}}
        },
        "serious_to_playful": {
          "type": "object",
          "properties": {"score": {"type": "integer"}, "description": {"type": "string"}}
        },
        "abstract_to_concrete": {
          "type": "object",
          "properties": {"score": {"type": "integer"}, "description": {"type": "string"}}
        },
        "we_to_you": {
          "type": "object",
          "properties": {"score": {"type": "integer"}, "description": {"type": "string"}}
        }
      }
    },
    "writing_mechanics": {
      "type": "object",
      "properties": {
        "avg_sentence_length_words": {"type": "integer"},
        "max_paragraph_sentences": {"type": "integer"},
        "reading_level_grade": {"type": "integer"},
        "contractions": {"type": "string", "enum": ["always", "never", "context_dependent"]},
        "oxford_comma": {"type": "boolean"},
        "exclamation_policy": {"type": "string"}
      }
    },
    "channel_adaptations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "formality_score", "emoji_ok"],
        "properties": {
          "channel": {"type": "string"},
          "formality_score": {"type": "integer", "minimum": 1, "maximum": 10},
          "avg_length": {"type": "string"},
          "emoji_ok": {"type": "boolean"},
          "special_notes": {"type": "string"}
        }
      }
    },
    "banned_words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "why", "use_instead"],
        "properties": {
          "word": {"type": "string"},
          "why": {"type": "string"},
          "use_instead": {"type": "string"}
        }
      },
      "minItems": 10
    },
    "quick_reference": {
      "type": "object",
      "required": ["we_are", "we_are_not", "top_5_rules", "on_brand_examples"],
      "properties": {
        "we_are": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 3},
        "we_are_not": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 3},
        "top_5_rules": {"type": "array", "items": {"type": "string"}, "minItems": 5, "maxItems": 5},
        "on_brand_examples": {"type": "array", "items": {"type": "string"}, "minItems": 3}
      }
    }
  }
}
