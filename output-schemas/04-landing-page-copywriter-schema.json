{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Landing Page Copywriter Output",
  "description": "Structured output schema for landing page copy creation",
  "type": "object",
  "required": ["strategy", "page_copy"],
  "properties": {
    "strategy": {
      "type": "object",
      "required": ["target_audience", "awareness_stage", "conversion_goal", "key_objections"],
      "properties": {
        "target_audience": { "type": "string" },
        "awareness_stage": { "type": "string", "enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware"] },
        "conversion_goal": { "type": "string" },
        "key_objections": { "type": "array", "items": { "type": "string" } },
        "emotional_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "page_copy": {
      "type": "object",
      "required": ["hero", "problem_section", "solution_section", "features_benefits", "social_proof", "final_cta"],
      "properties": {
        "hero": {
          "type": "object",
          "required": ["headline", "subheadline", "cta"],
          "properties": {
            "headline": { "type": "string" },
            "subheadline": { "type": "string" },
            "cta": { "type": "object", "properties": { "text": { "type": "string" }, "destination": { "type": "string" } } },
            "supporting_text": { "type": "string" },
            "visual_direction": { "type": "string" }
          }
        },
        "problem_section": { "type": "object", "properties": { "headline": { "type": "string" }, "copy": { "type": "string" } } },
        "solution_section": { "type": "object", "properties": { "headline": { "type": "string" }, "copy": { "type": "string" } } },
        "features_benefits": {
          "type": "array",
          "items": { "type": "object", "required": ["feature", "benefit"], "properties": { "feature": { "type": "string" }, "benefit": { "type": "string" }, "supporting_detail": { "type": "string" } } }
        },
        "social_proof": {
          "type": "object",
          "properties": {
            "testimonials": { "type": "array", "items": { "type": "object", "properties": { "quote": { "type": "string" }, "author": { "type": "string" }, "company": { "type": "string" }, "result": { "type": "string" } } } },
            "stats": { "type": "string" },
            "logos": { "type": "array", "items": { "type": "string" } },
            "trust_badges": { "type": "array", "items": { "type": "string" } }
          }
        },
        "objection_handling": {
          "type": "array",
          "items": { "type": "object", "required": ["objection", "response"], "properties": { "objection": { "type": "string" }, "response": { "type": "string" } } }
        },
        "final_cta": {
          "type": "object",
          "required": ["headline", "cta", "risk_reversal"],
          "properties": { "headline": { "type": "string" }, "cta": { "type": "string" }, "risk_reversal": { "type": "string" } }
        }
      }
    },
    "optimization": {
      "type": "object",
      "properties": {
        "ab_tests": { "type": "array", "items": { "type": "object", "properties": { "element": { "type": "string" }, "variant_a": { "type": "string" }, "variant_b": { "type": "string" }, "hypothesis": { "type": "string" } } } },
        "seo": { "type": "object", "properties": { "title_tag": { "type": "string" }, "meta_description": { "type": "string" } } }
      }
    }
  }
}
