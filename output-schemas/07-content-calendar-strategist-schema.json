{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Calendar Strategist Output",
  "description": "Structured output schema for editorial content calendar planning",
  "type": "object",
  "required": ["strategy", "calendar"],
  "properties": {
    "strategy": {
      "type": "object",
      "required": ["business_goals", "content_pillars", "channel_strategy"],
      "properties": {
        "business_goals": { "type": "array", "items": { "type": "object", "properties": { "goal": { "type": "string" }, "content_objective": { "type": "string" }, "key_metric": { "type": "string" }, "monthly_target": { "type": "string" } } } },
        "content_pillars": { "type": "array", "items": { "type": "object", "required": ["name", "goal", "ratio"], "properties": { "name": { "type": "string" }, "goal": { "type": "string" }, "ratio": { "type": "string" }, "example_topics": { "type": "array", "items": { "type": "string" } } } } },
        "channel_strategy": { "type": "array", "items": { "type": "object", "properties": { "channel": { "type": "string" }, "frequency": { "type": "string" }, "content_type": { "type": "string" }, "primary_goal": { "type": "string" } } } },
        "capacity_assessment": { "type": "object", "properties": { "team_size": { "type": "string" }, "hours_per_week": { "type": "string" }, "realistic_output": { "type": "string" } } }
      }
    },
    "calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["week", "theme", "content"],
        "properties": {
          "week": { "type": "integer" },
          "theme": { "type": "string" },
          "key_dates": { "type": "array", "items": { "type": "string" } },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["day", "channel", "title", "content_type"],
              "properties": {
                "day": { "type": "string" },
                "channel": { "type": "string" },
                "title": { "type": "string" },
                "content_type": { "type": "string" },
                "keyword": { "type": "string" },
                "cta": { "type": "string" },
                "owner": { "type": "string" },
                "status": { "type": "string", "enum": ["planned", "in_progress", "in_review", "scheduled", "published"] },
                "production_time": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "production_pipeline": {
      "type": "array",
      "items": { "type": "object", "properties": { "content_piece": { "type": "string" }, "research_date": { "type": "string" }, "draft_date": { "type": "string" }, "review_date": { "type": "string" }, "design_date": { "type": "string" }, "publish_date": { "type": "string" }, "promote_date": { "type": "string" } } }
    },
    "repurposing_matrix": {
      "type": "array",
      "items": { "type": "object", "properties": { "anchor_content": { "type": "string" }, "derivatives": { "type": "array", "items": { "type": "object", "properties": { "channel": { "type": "string" }, "format": { "type": "string" }, "description": { "type": "string" } } } } } }
    },
    "promotion_plan": {
      "type": "object",
      "properties": {
        "per_content_checklist": { "type": "array", "items": { "type": "string" } },
        "paid_amplification": { "type": "array", "items": { "type": "object", "properties": { "content_piece": { "type": "string" }, "budget": { "type": "string" }, "platform": { "type": "string" } } } }
      }
    },
    "measurement": {
      "type": "object",
      "properties": {
        "scorecard_template": { "type": "array", "items": { "type": "object", "properties": { "metric": { "type": "string" }, "target": { "type": "string" }, "tracking_tool": { "type": "string" } } } },
        "review_cadence": { "type": "string" }
      }
    }
  }
}
