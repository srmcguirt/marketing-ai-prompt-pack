{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Email Sequence",
  "type": "object",
  "required": ["sequence_name", "trigger", "goal", "total_emails", "duration_days", "emails"],
  "properties": {
    "sequence_name": {"type": "string"},
    "trigger": {"type": "string"},
    "goal": {"type": "string"},
    "total_emails": {"type": "integer", "minimum": 1, "maximum": 20},
    "duration_days": {"type": "integer"},
    "tone": {"type": "string"},
    "emails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["email_number", "day", "theme", "subject_lines", "preview_text", "body", "cta"],
        "properties": {
          "email_number": {"type": "integer"},
          "day": {"type": "integer"},
          "theme": {"type": "string"},
          "subject_lines": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["option", "text"],
              "properties": {
                "option": {"type": "string", "enum": ["A", "B", "C"]},
                "type": {"type": "string"},
                "text": {"type": "string", "maxLength": 70}
              }
            }
          },
          "preview_text": {"type": "string", "maxLength": 90},
          "body": {"type": "string", "minLength": 100, "maxLength": 1500},
          "cta": {
            "type": "object",
            "required": ["text", "destination"],
            "properties": {
              "text": {"type": "string"},
              "destination": {"type": "string"}
            }
          },
          "ps": {"type": "string"},
          "segmentation_rules": {"type": "string"},
          "deliverability_flags": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "sequence_notes": {"type": "string"},
    "ab_test_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email_number": {"type": "integer"},
          "variable": {"type": "string"},
          "version_a": {"type": "string"},
          "version_b": {"type": "string"}
        }
      }
    }
  }
}
